    {
      "type": "timeseries",
      "title": "Total download time",
      "description": "Start of the check to the last byte, per image. Spikes on every image at once point to our network or the whole site; one image alone points to that file or its server.",
      "datasource": {
        "type": "influxdb",
        "uid": "archmon-influx"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "archmon-influx"
          },
          "query": "from(bucket: \"environment_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"web_probe\" and contains(value: r.target, set: ${target:json}))\n  |> filter(fn: (r) => r._field == \"total_ms\")\n  |> group(columns: [\"target\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, _field: r.target}))\n  |> group(columns: [\"_field\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": 10800000,
            "drawStyle": "line",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6
    },
    {
