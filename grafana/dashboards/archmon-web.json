    {
      "type": "timeseries",
      "title": "Where the time goes",
      "description": "Average time per step across the selected images, stacked. Large DNS = name lookup problem; Connect/TLS = network distance or busy server; Server wait = slow website backend; Transfer = bandwidth.",
      "datasource": {
        "type": "influxdb",
        "uid": "archmon-influx"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "archmon-influx"
          },
          "query": "from(bucket: \"environment_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"web_probe\" and contains(value: r.target, set: ${target:json}))\n  |> filter(fn: (r) => contains(value: r._field, set: [\"dns_ms\", \"connect_ms\", \"tls_ms\", \"ttfb_ms\", \"download_ms\"]))\n  |> group(columns: [\"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _field: if r._field == \"dns_ms\" then \"1 DNS lookup\" else if r._field == \"connect_ms\" then \"2 Connect\"\n      else if r._field == \"tls_ms\" then \"3 TLS handshake\" else if r._field == \"ttfb_ms\" then \"4 Server wait\" else \"5 Transfer\"}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 70,
            "showPoints": "auto",
            "spanNulls": 10800000,
