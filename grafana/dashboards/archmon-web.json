          "query": "from(bucket: \"environment_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"web_probe\" and contains(value: r.target, set: ${target:json}))\n  |> filter(fn: (r) => r._field == \"total_ms\")\n  |> toFloat()\n  |> group()\n  |> quantile(q: 0.95)"
        }
