  "panels": [
    {
      "type": "stat",
      "title": "Median total time",
      "description": "Half of the successful downloads in the period were faster than this (DNS + connect + TLS + server wait + transfer).",
      "datasource": {
        "type": "influxdb",
        "uid": "archmon-influx"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "archmon-influx"
          },
          "query": "from(bucket: \"environment_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"web_probe\" and contains(value: r.target, set: ${target:json}))\n  |> filter(fn: (r) => r._field == \"total_ms\")\n  |> toFloat()\n  |> group()\n  |> median()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1F6FB2",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Slowest 5 %",
      "description": "95th percentile of total download time: what a visitor sees at a bad moment.",
      "datasource": {
        "type": "influxdb",
        "uid": "archmon-influx"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
