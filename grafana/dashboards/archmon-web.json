    {
      "type": "table",
      "title": "Website images",
      "datasource": {
        "type": "influxdb",
        "uid": "archmon-influx"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "description": "One row per monitored image for the selected period. Last check turns amber when no check has run for 90 minutes (the webmon container may be stopped).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "archmon-influx"
          },
          "query": "base = from(bucket: \"environment_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"web_probe\" and contains(value: r.target, set: ${target:json}))\nlast_ok = base |> filter(fn: (r) => r._field == \"ok\") |> toFloat() |> group(columns: [\"target\", \"host\"]) |> last()\n  |> map(fn: (r) => ({target: r.target, host: r.host, _field: \"last_ok\", _value: r._value}))\nlast_status = base |> filter(fn: (r) => r._field == \"status\") |> toFloat() |> group(columns: [\"target\", \"host\"]) |> last()\n  |> map(fn: (r) => ({target: r.target, host: r.host, _field: \"last_status\", _value: r._value}))\nsize = base |> filter(fn: (r) => r._field == \"bytes\") |> toFloat() |> group(columns: [\"target\", \"host\"]) |> last()\n  |> map(fn: (r) => ({target: r.target, host: r.host, _field: \"size\", _value: r._value}))\nmed_ms = base |> filter(fn: (r) => r._field == \"total_ms\") |> toFloat() |> group(columns: [\"target\", \"host\"]) |> median()\n  |> map(fn: (r) => ({target: r.target, host: r.host, _field: \"med_ms\", _value: r._value}))\np95_ms = base |> filter(fn: (r) => r._field == \"total_ms\") |> toFloat() |> group(columns: [\"target\", \"host\"]) |> quantile(q: 0.95)\n  |> map(fn: (r) => ({target: r.target, host: r.host, _field: \"p95_ms\", _value: r._value}))\nttfb = base |> filter(fn: (r) => r._field == \"ttfb_ms\") |> toFloat() |> group(columns: [\"target\", \"host\"]) |> median()\n  |> map(fn: (r) => ({target: r.target, host: r.host, _field: \"ttfb\", _value: r._value}))\nspeed = base |> filter(fn: (r) => r._field == \"mbps\") |> toFloat() |> group(columns: [\"target\", \"host\"]) |> median()\n  |> map(fn: (r) => ({target: r.target, host: r.host, _field: \"speed\", _value: r._value}))\npct_ok = base |> filter(fn: (r) => r._field == \"ok\") |> toFloat() |> group(columns: [\"target\", \"host\"]) |> mean() |> map(fn: (r) => ({r with _value: r._value * 100.0}))\n  |> map(fn: (r) => ({target: r.target, host: r.host, _field: \"pct_ok\", _value: r._value}))\nchecks = base |> filter(fn: (r) => r._field == \"ok\") |> toFloat() |> group(columns: [\"target\", \"host\"]) |> count() |> toFloat()\n  |> map(fn: (r) => ({target: r.target, host: r.host, _field: \"checks\", _value: r._value}))\nage = base |> filter(fn: (r) => r._field == \"ok\") |> group(columns: [\"target\", \"host\"]) |> last()\n  |> map(fn: (r) => ({target: r.target, host: r.host, _field: \"age_min\", _value: float(v: int(v: now()) - int(v: r._time)) / 60000000000.0}))\nunion(tables: [last_ok, last_status, size, med_ms, p95_ms, ttfb, speed, pct_ok, checks, age])\n  |> group()\n  |> pivot(rowKey: [\"target\", \"host\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> sort(columns: [\"target\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
