                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#2E8540",
                      "value": null
                    },
                    {
                      "color": "#E3A008",
                      "value": 1
                    },
                    {
                      "color": "#C81E1E",
                      "value": 48
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "twpi"
            },
            "properties": [
              {
