    },
    {
      "type": "link",
      "title": "Website",
      "url": "/d/archmon-web",
      "keepTime": true,
      "icon": "dashboard",
      "tooltip": "",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Settings",
      "url": "/d/archmon-settings",
      "keepTime": true,
      "icon": "dashboard",
      "tooltip": "",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "archmon-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"environment_raw\", tag: \"site\", start: -30d,\n  predicate: (r) => r._measurement == \"environment\" and r.room_type != \"unregistered\")",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {},
        "sort": 1
      },
      {
        "name": "room_type",
        "label": "Room type",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "archmon-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"environment_raw\", tag: \"room_type\", start: -30d,\n  predicate: (r) => r._measurement == \"environment\" and r.room_type != \"unregistered\" and contains(value: r.site, set: ${site:json}))",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {},
        "sort": 1
      },
      {
        "name": "room",
        "label": "Room",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "archmon-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"environment_raw\", tag: \"room\", start: -30d,\n  predicate: (r) => r._measurement == \"environment\" and r.room_type != \"unregistered\" and contains(value: r.site, set: ${site:json}) and contains(value: r.room_type, set: ${room_type:json}))",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Room compliance for the selected period",
      "datasource": {
        "type": "influxdb",
        "uid": "archmon-influx"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "archmon-influx"
          },
          "query": "import \"math\"\npi = (t, h) => 45.0 * (50.0 / h) * math.exp(x: 12028.0 * (1.0 / (t + 273.15) - 1.0 / 293.15))\nf = (c) => c * 1.8 + 32.0\nfrom(bucket: \"environment_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r.room_type != \"test\" and r.room_type != \"unregistered\")\n  |> filter(fn: (r) => r._field == \"temperature_c\" or r._field == \"humidity_rh\" or r._field == \"status\")\n  |> filter(fn: (r) => contains(value: r.site, set: ${site:json}))\n  |> filter(fn: (r) => contains(value: r.room_type, set: ${room_type:json}))\n  |> filter(fn: (r) => contains(value: r.room, set: ${room:json}))\n  |> group(columns: [\"building\", \"floor\", \"room\", \"_field\"])\n  |> aggregateWindow(every: 15m, fn: max, createEmpty: false)\n  |> toFloat()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.temperature_c and exists r.humidity_rh and exists r.status)\n  |> reduce(identity: {n: 0.0, ok: 0.0, alarm: 0.0, mould: 0.0, ts: 0.0, tmin: 1000.0, tmax: -1000.0, hs: 0.0, hmin: 1000.0, hmax: -1000.0, ipi: 0.0},\n      fn: (r, accumulator) => ({n: accumulator.n + 1.0,\n        ok: accumulator.ok + (if r.status == 0.0 then 1.0 else 0.0),\n        alarm: accumulator.alarm + (if r.status >= 2.0 then 1.0 else 0.0),\n        mould: accumulator.mould + (if r.humidity_rh > 65.0 then 1.0 else 0.0),\n        ts: accumulator.ts + r.temperature_c, tmin: math.mMin(x: accumulator.tmin, y: r.temperature_c), tmax: math.mMax(x: accumulator.tmax, y: r.temperature_c),\n        hs: accumulator.hs + r.humidity_rh, hmin: math.mMin(x: accumulator.hmin, y: r.humidity_rh), hmax: math.mMax(x: accumulator.hmax, y: r.humidity_rh),\n        ipi: accumulator.ipi + 1.0 / pi(t: r.temperature_c, h: r.humidity_rh)}))\n  |> map(fn: (r) => ({building: r.building, floor: r.floor, room: r.room,\n      pct_ok: 100.0 * r.ok / r.n, pct_alarm: 100.0 * r.alarm / r.n, mould_h: r.mould / 4.0,\n      t_mean: f(c: r.ts / r.n), t_min: f(c: r.tmin), t_max: f(c: r.tmax),\n      h_mean: r.hs / r.n, h_min: r.hmin, h_max: r.hmax, twpi: r.n / r.ipi, coverage_d: r.n / 96.0}))\n  |> group()\n  |> sort(columns: [\"building\", \"floor\", \"room\"])"
        }
      ],
      "description": "Based on 15-minute intervals. Default: this month so far. For a finished month use the time picker → 'Previous month'. Export: panel menu → Inspect → Data → Download CSV.",
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "building"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Building"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "floor"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Floor"
              },
              {
                "id": "custom.width",
                "value": 60
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "room"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Room"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open room detail",
                    "url": "/d/archmon-room?var-one_building=${__data.fields.building}&var-one_room=${__value.text}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pct_ok"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Time in range"
              },
