      "title": "Room Detail",
      "url": "/d/archmon-room",
      "keepTime": true,
      "icon": "dashboard",
      "tooltip": "",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Monthly Report",
      "url": "/d/archmon-report",
      "keepTime": false,
      "icon": "dashboard",
      "tooltip": "",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Leaks & Air Quality",
      "url": "/d/archmon-air",
      "keepTime": true,
      "icon": "dashboard",
      "tooltip": "",
