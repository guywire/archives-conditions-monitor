                      "value": null
                    },
                    {
                      "color": "#E3A008",
                      "value": 80
                    },
                    {
                      "color": "#2E8540",
                      "value": 95
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pct_alarm"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Time in alarm"
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#2E8540",
                      "value": null
                    },
                    {
                      "color": "#E3A008",
                      "value": 0.1
                    },
                    {
                      "color": "#C81E1E",
