            "uid": "archmon-influx"
          },
          "query": "import \"math\"\nr0 = (x) => string(v: int(v: math.round(x: x)))\nfrom(bucket: \"environment_raw\")\n  |> range(start: -1d)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r.building == \"${one_building}\" and r.room == \"${one_room}\")\n  |> filter(fn: (r) => contains(value: r._field, set: [\"t_min_c\", \"t_max_c\", \"rh_min\", \"rh_max\"]))\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"room\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({target: r0(x: r.t_min_c * 1.8 + 32.0) + \"–\" + r0(x: r.t_max_c * 1.8 + 32.0) + \" °F  ·  \" + r0(x: r.rh_min) + \"–\" + r0(x: r.rh_max) + \" % RH\"}))"
        }
