    {
      "type": "table",
      "title": "Leaks and air quality",
      "datasource": {
        "type": "influxdb",
        "uid": "archmon-influx"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "description": "Latest state of water-leak probes and air-quality sensors. Limits: see 'Alarm rules and target ranges' on the Overview. Shows 'No data' if this room has no leak or air-quality sensor.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "archmon-influx"
          },
          "query": "import \"math\"\nimport \"strings\"\nr0 = (x) => string(v: int(v: math.round(x: x)))\nbase = from(bucket: \"environment_raw\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r.building == \"${one_building}\" and r.room == \"${one_room}\")\n  |> last()\n  |> toFloat()\nleak = base\n  |> filter(fn: (r) => r._measurement == \"leak\" and r._field == \"water\")\n  |> map(fn: (r) => ({building: r.building, floor: r.floor, room: r.room, sensor_id: r.sensor_id, kind: \"Water leak\",\n      status: r._value * 2.0, reading: if r._value > 0.0 then \"WATER DETECTED\" else \"Dry\",\n      why: if r._value > 0.0 then \"Water at the probe: check now\" else \"Dry\"}))\nair = base\n  |> filter(fn: (r) => r._measurement == \"air_quality\")\n  |> group()\n  |> pivot(rowKey: [\"building\", \"floor\", \"room\", \"sensor_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => {\n      w = (if exists r.pm25_status and r.pm25_status > 0.0 then \"PM2.5 above \" + r0(x: if r.pm25_status > 1.0 then 25.0 else 10.0) + \"; \" else \"\") + (if exists r.pm10_status and r.pm10_status > 0.0 then \"PM10 above \" + r0(x: if r.pm10_status > 1.0 then 50.0 else 20.0) + \"; \" else \"\") + (if exists r.co2_ppm_status and r.co2_ppm_status > 0.0 then \"CO2 above \" + r0(x: if r.co2_ppm_status > 1.0 then 2000.0 else 1000.0) + \"; \" else \"\") + (if exists r.voc_index_status and r.voc_index_status > 0.0 then \"VOC index above \" + r0(x: if r.voc_index_status > 1.0 then 300.0 else 200.0) + \"; \" else \"\") + (if exists r.nox_index_status and r.nox_index_status > 0.0 then \"NOx index above \" + r0(x: if r.nox_index_status > 1.0 then 100.0 else 20.0) + \"; \" else \"\")\n      rd = (if exists r.pm25 then \"PM2.5 \" + r0(x: r.pm25) + \" µg/m³\" else \"\") + \" · \" + (if exists r.pm10 then \"PM10 \" + r0(x: r.pm10) + \" µg/m³\" else \"\") + \" · \" + (if exists r.co2_ppm then \"CO2 \" + r0(x: r.co2_ppm) + \" ppm\" else \"\") + \" · \" + (if exists r.voc_index then \"VOC index \" + r0(x: r.voc_index) + \"\" else \"\") + \" · \" + (if exists r.nox_index then \"NOx index \" + r0(x: r.nox_index) + \"\" else \"\")\n      return {building: r.building, floor: r.floor, room: r.room, sensor_id: r.sensor_id, kind: \"Air quality\", status: r.status,\n        reading: strings.trim(v: strings.replaceAll(v: rd, t: \" ·  · \", u: \" · \"), cutset: \" ·\"),\n        why: if w == \"\" then \"In range\" else strings.trimSuffix(v: w, suffix: \"; \")}\n    })\nunion(tables: [leak |> group(), air])\n  |> sort(columns: [\"building\", \"floor\", \"room\", \"kind\"])"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Status"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "color": "#2E8540",
                        "index": 0
                      },
                      "1": {
                        "text": "Watch",
                        "color": "#E3A008",
                        "index": 1
                      },
                      "2": {
                        "text": "Alarm",
                        "color": "#C81E1E",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
