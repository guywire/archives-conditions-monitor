        "name": "one_building",
        "label": "Building",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "archmon-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"environment_raw\", tag: \"building\", start: -30d,\n  predicate: (r) => r._measurement == \"environment\" and r.room_type != \"unregistered\")",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {},
        "sort": 1
      },
      {
        "name": "one_room",
        "label": "Room",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "archmon-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"environment_raw\", tag: \"room\", start: -30d,\n  predicate: (r) => r._measurement == \"environment\" and r.room_type != \"unregistered\" and r.building == \"${one_building}\")",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {},
        "sort": 1
      }
