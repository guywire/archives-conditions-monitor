          },
          "query": "from(bucket: \"environment_raw\")\n  |> range(start: -1d)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r.building == \"${one_building}\" and r.room == \"${one_room}\" and r._field == \"status\")\n  |> group()\n  |> last()\n"
